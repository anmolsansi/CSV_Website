# Postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/csvapp

# Runtime
# Keep "development" for local use. Production startup enables stricter safety checks.
ENVIRONMENT=development

# Session / JWT
# Production requires at least 32 random bytes and rejects known placeholder values.
# Generate outside the repository, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# or:
#   openssl rand -hex 32
# Store the production value in the deployment platform's secret manager, never in source control.
SECRET_KEY=change-me-to-a-long-random-string

# Local development/test only. Production startup rejects TEST_AUTH=true.
TEST_AUTH=true

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure portal > App registrations)
# Redirect URI: http://localhost:8000/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Apple Sign In (Apple Developer > Certificates, Identifiers & Profiles)
# Redirect URI: http://localhost:8000/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/app/secrets/apple_key.p8

# OAuth redirect + frontend
# Localhost HTTP values are supported only in development/test.
# Production requires public HTTPS values for FRONTEND_URL and OAUTH_REDIRECT_BASE.
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Development/test may use localhost origins.
# Production must set CORS_ORIGINS explicitly and every origin must be public HTTPS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cleanup
CLEANUP_INTERVAL_MINUTES=60
DELETE_AFTER_DAYS=2
